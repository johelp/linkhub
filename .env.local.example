# ─── Supabase ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LinkHub

# ─── Stripe (pagos) ─────────────────────────────────────────────
# Ver SETUP.md § Stripe para cómo obtener cada valor.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PRO=price_...

# ─── Mercado Pago (bloque "Cobrar") ──────────────────────────────
# Ver SETUP.md § Mercado Pago para cómo obtener cada valor.
# MERCADOPAGO_CLIENT_ID=
# MERCADOPAGO_CLIENT_SECRET=
# MERCADOPAGO_WEBHOOK_SECRET=

# ─── Resend (email de entradas) ──────────────────────────────────
# Ver SETUP.md § Entradas para cómo obtener cada valor.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=LinkHub <onboarding@resend.dev>
